# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Redis Configuration (defaults to 127.0.0.1:6379)
REDIS_URL="redis://127.0.0.1:6379"

# PostgreSQL Configuration (defaults to embedded persistent PGlite PostgreSQL)
# DATABASE_URL="postgresql://postgres:password@localhost:5432/reachinbox"

# Scheduler & Concurrency Settings
WORKER_CONCURRENCY=5
MIN_DELAY_BETWEEN_EMAILS_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=10

# Slack Integration (can also be connected via Dashboard UI)
SLACK_WEBHOOK_URL=""

# Ethereal Email Credentials (auto-generated on startup if left empty)
ETHEREAL_USER=""
ETHEREAL_PASS=""

